// Copy this file to Secrets.xcconfig (gitignored) and fill in your values.
//
// CLICKY_PROXY_SHARED_SECRET must match the worker's secret of the same name:
//   openssl rand -hex 32
//   cd worker && npx wrangler secret put CLICKY_PROXY_SHARED_SECRET
//
// Use a hex value: xcconfig treats `//` as the start of a comment, so
// secrets containing slashes get silently truncated.

CLICKY_PROXY_SHARED_SECRET = paste-your-hex-secret-here

// Base URL of your Cloudflare Worker, without a trailing slash. Keep the
// `$()` between the slashes so xcconfig doesn't read `//` as a comment.
// For local development against `npx wrangler dev`:
//   CLICKY_WORKER_BASE_URL = http:/$()/localhost:8787

CLICKY_WORKER_BASE_URL = https:/$()/your-worker-name.your-subdomain.workers.dev
